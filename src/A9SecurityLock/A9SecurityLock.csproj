<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Allows building the windows-targeted project from non-Windows CI/dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Minimum supported OS: Windows 10 / Server 2016 (build 1809). -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <AssemblyName>A9SecurityLock</AssemblyName>
    <RootNamespace>A9SecurityLock</RootNamespace>
    <ApplicationIcon>Resources\A9Logo.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>A9 Security Lock</Product>
    <Company>A9 Software</Company>
    <Copyright>Copyright © 2026 A9 Software</Copyright>

    <!-- Trimmed/optimized self-contained publish knobs are configured in the publish scripts,
         not here, so that plain "dotnet build" keeps working for everyone. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Update="app.manifest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
